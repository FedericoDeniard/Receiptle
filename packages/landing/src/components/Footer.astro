---
import type { LandingStrings } from "../i18n";
import DecorativeSquare from "./DecorativeSquare.astro";

interface Props {
  strings: LandingStrings;
}

const { strings } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class="bg-white border-t border-[var(--text-secondary)]/10 py-12"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="flex flex-col md:flex-row justify-between items-center gap-6"
    >
      <div class="flex items-center gap-3">
        <div
          class="relative size-6 flex items-center justify-center shrink-0 grayscale opacity-50"
        >
          <DecorativeSquare size={24} class="absolute inset-0 m-auto" />
          <img
            src="/logo.svg"
            alt="Receiptle"
            class="relative z-10 w-full h-full p-0.5 object-contain"
          />
        </div>
        <span class="font-semibold text-[var(--text-secondary)]">Receiptle</span>
      </div>
      <div class="flex gap-6 text-sm text-[var(--text-secondary)]">
        <a
          href="https://federicodeniard-receiptle.mintlify.app/"
          class="hover:text-[var(--primary)] transition-colors"
        >
          {strings.nav.documentation}
        </a>
        <a
          href="https://github.com/federicodeniard/receiptle"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--primary)] transition-colors"
        >
          {strings.nav.github}
        </a>
        <a
          href="/privacy"
          class="hover:text-[var(--primary)] transition-colors"
        >
          {strings.nav.privacy}
        </a>
      </div>
    </div>
    <div class="mt-8 text-center text-sm text-[var(--text-secondary)]/60">
      &copy; {currentYear} Receiptle. {strings.nav.personalProject}
    </div>
  </div>
</footer>
