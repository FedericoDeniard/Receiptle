---
import type { LandingStrings } from "../i18n";
import SubscriptionMockList from "./SubscriptionMockList.astro";
import TransactionMockList from "./TransactionMockList.astro";

interface Props {
  strings: LandingStrings;
  locale: string;
}

const { strings, locale } = Astro.props;
---

<div class="mt-20 relative max-w-5xl mx-auto anim-rise" style="--anim-delay: 500ms">
  <div
    class="absolute inset-0 bg-linear-to-t from-[var(--bg-primary)] via-transparent to-transparent z-10 pointer-events-none"
  >
  </div>
  <div
    class="relative rounded-2xl border border-[var(--text-secondary)]/20 bg-[var(--bg-secondary)] shadow-2xl overflow-hidden h-[500px]"
  >
    <div
      class="flex items-center gap-2 px-4 py-3 border-b border-[var(--text-secondary)]/10 bg-white/50 relative z-20"
    >
      <div class="size-3 rounded-full bg-red-400"></div>
      <div class="size-3 rounded-full bg-amber-400"></div>
      <div class="size-3 rounded-full bg-green-400"></div>
    </div>

    <div class="relative w-full h-[calc(100%-49px)] overflow-hidden">
      <SubscriptionMockList strings={strings} locale={locale} />
      <TransactionMockList strings={strings} />
    </div>
  </div>
</div>
