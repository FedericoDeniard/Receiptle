---
import type { LandingStrings } from "../i18n";
import { TRANSACTIONS_MOCK } from "../mock/hero";

interface Props {
  strings: LandingStrings;
}

const { strings } = Astro.props;
---

<div
  class="absolute inset-0 p-8 pb-12 opacity-90 pointer-events-none select-none flex flex-col gap-6 mock-panel-b"
  aria-hidden="true"
>
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-semibold text-[var(--text-primary)]">
        {strings.mock.transactionsTitle}
      </h2>
      <p class="text-[var(--text-secondary)]">
        {strings.mock.transactionsSubtitle}
      </p>
    </div>
    <div class="text-right hidden sm:block">
      <div class="text-sm text-[var(--text-secondary)]">
        {strings.mock.balanceLabel}
      </div>
      <div class="text-xl font-bold text-emerald-600">
        {strings.mock.balanceAmount}
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-3">
    {
      TRANSACTIONS_MOCK.map(tx => (
        <div class="relative p-4 rounded-2xl shadow-sm bg-white border border-[var(--text-secondary)]/10">
          <div class="relative flex items-center gap-4">
            <div class="flex-1 min-w-0">
              <h3 class="font-semibold truncate text-[var(--text-primary)]">
                {tx.title}
              </h3>
              <p class="text-sm truncate text-[var(--text-secondary)]">
                {tx.category}
              </p>
              <p class="text-xs mt-0.5 text-zinc-400">{tx.date}</p>
            </div>
            <div class="text-right shrink-0">
              <span class:list={["text-lg font-bold block", tx.amountClass]}>
                {tx.amount}
              </span>
              <span class="text-xs block text-zinc-400">{tx.currency}</span>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>
