---
interface Props {
  size?: number;
  class?: string;
}

const { size = 100, class: className = "" } = Astro.props;

function borderRadius(size: number) {
  if (size <= 50) return "rounded-lg";
  if (size <= 100) return "rounded-xl";
  if (size <= 200) return "rounded-2xl";
  return "rounded-3xl";
}
---

<div
  class={`bg-[var(--accent)] ${borderRadius(size)} opacity-90 ${className}`}
  style={`width:${size}px;height:${size}px;transform:rotate(16deg)`}
  aria-hidden="true"
>
</div>
