# Supabase Configuration
# Local dev only: use the publishable key (`sb_publishable_...`) printed by
# `supabase status` for THIS local stack. Never paste production keys here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your_local_publishable_key_here

# Frontend server
PORT=3000

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# The public key is exposed to the browser via /api/config (safe to expose)
# The private key must NEVER be exposed to the browser — store in Supabase Vault in production
VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY is NOT read by the frontend server — it lives only in supabase/functions/.env

# Optional (used by E2E tests)
XAI_API_KEY=

# Feature flags
# CHAT_ENABLED — set to "false" to hide the Assistant route and sidebar link.
# Defaults to true when unset.
CHAT_ENABLED=true