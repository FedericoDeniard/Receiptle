---
import type { LandingStrings } from "../i18n";
import { interpolate } from "../i18n";
import { SUBSCRIPTIONS_MOCK, formatCurrency, formatNextDate } from "../mock/hero";
import Icon from "./Icon.astro";

interface Props {
  strings: LandingStrings;
  locale: string;
}

const { strings, locale } = Astro.props;

function statusClass(status: "active" | "inactive") {
  return status === "active"
    ? "bg-emerald-100 text-emerald-700"
    : "bg-rose-100 text-rose-700";
}
---

<div
  class="absolute inset-0 p-8 pb-12 opacity-90 pointer-events-none select-none flex flex-col gap-6 mock-panel-a"
  aria-hidden="true"
>
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-semibold text-[var(--text-primary)]">
        {strings.mock.subscriptionsTitle}
      </h2>
      <p class="text-[var(--text-secondary)]">
        {strings.mock.subscriptionsSubtitle}
      </p>
    </div>
    <div class="text-right hidden sm:block">
      <div class="text-sm text-[var(--text-secondary)]">
        {strings.mock.totalLabel}
      </div>
      <div class="text-xl font-bold text-[var(--text-primary)]">
        {strings.mock.totalAmount}
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-3">
    {
      SUBSCRIPTIONS_MOCK.map(sub => (
        <div class="flex flex-col rounded-xl border border-[var(--text-secondary)]/20 bg-[var(--bg-primary)] shadow-sm">
          <div class="flex items-center gap-3 sm:gap-4 p-3 sm:p-4 w-full text-left">
            <div class="flex size-10 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-full bg-[var(--bg-secondary)] text-[var(--text-secondary)] font-bold text-sm sm:text-lg">
              {sub.merchant.charAt(0).toUpperCase()}
            </div>

            <div class="flex min-w-0 flex-1 flex-col justify-center gap-0.5 sm:gap-1">
              <div class="flex items-center gap-2">
                <h2 class="truncate text-sm sm:text-base font-semibold text-[var(--text-primary)]">
                  {sub.merchant}
                </h2>
                <span
                  class:list={[
                    "hidden sm:inline-block rounded-full px-2 py-0.5 text-[10px] font-medium",
                    statusClass(sub.status),
                  ]}
                >
                  {sub.status === "active"
                    ? strings.mock.statusActive
                    : strings.mock.statusInactive}
                </span>
              </div>

              <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-[var(--text-secondary)]">
                <span class="flex items-center gap-1 font-medium bg-[var(--bg-secondary)] px-1.5 py-0.5 rounded-md">
                  {sub.occurrences} {strings.mock.occurrences}
                </span>
                <span class="flex items-center gap-1">
                  <Icon name="repeat" size={12} class="shrink-0" />
                  {strings.mock.frequencyMonthly}
                </span>
                <span class="hidden sm:inline opacity-40">•</span>
                <span class="flex items-center gap-1">
                  <Icon name="calendar-clock" size={12} class="shrink-0" />
                  <span class="hidden sm:inline">
                    {strings.mock.nextLabel}:
                  </span>
                  <span class="sm:hidden">{strings.mock.nextShort}:</span>
                  {" "}
                  {formatNextDate(locale, sub.nextOffsetDays)}
                </span>
                <span class="hidden md:inline opacity-40">•</span>
                <span class="hidden md:flex items-center gap-1">
                  <Icon name="mail" size={12} class="shrink-0" />
                  {sub.consistent
                    ? strings.mock.consistent
                    : strings.mock.variable}
                </span>
              </div>
            </div>

            <div class="flex shrink-0 flex-col items-end justify-center gap-1 pl-2 text-right">
              <p class="text-sm sm:text-base font-semibold text-[var(--text-primary)]">
                {formatCurrency(sub.amount, sub.currency)}
                <span class="ml-1 text-xs font-normal text-[var(--text-secondary)]">
                  {sub.currency}
                </span>
              </p>

              <div class="flex items-center gap-2">
                <span
                  class:list={[
                    "sm:hidden rounded-full px-2 py-0.5 text-[10px] font-medium",
                    statusClass(sub.status),
                  ]}
                >
                  {sub.status === "active"
                    ? strings.mock.statusActive
                    : strings.mock.statusInactive}
                </span>
                <span class="hidden sm:inline-block text-[10px] sm:text-xs text-[var(--text-secondary)] bg-[var(--bg-secondary)] px-2 py-0.5 rounded-full">
                  {interpolate(strings.mock.confidence, {
                    value: sub.confidence,
                  })}
                </span>
                <Icon
                  name="chevron-down"
                  size={18}
                  class="text-[var(--text-secondary)]"
                />
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>
